<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eeeeee">

    <!-- 表头布局 -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#D0D0D0"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/headerQty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QTY"
            android:gravity="center" />

        <TextView
            android:id="@+id/headerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="Name"
            android:gravity="center" />

        <TextView
            android:id="@+id/headerModify"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text=""
            android:gravity="center" />

        <TextView
            android:id="@+id/headerPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Price"
            android:gravity="center" />
    </LinearLayout>

    <!-- ListView -->
    <org.cas.client.platform.bar.panel.PIMTable
        android:id="@+id/tableListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/footerContainer"
        android:layout_weight="1" />

    <!-- 总金额显示区域和操作按钮容器 -->
    <RelativeLayout
        android:id="@+id/footerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#00FF00"
        android:padding="8dp">

        <!-- 底部费用详细 -->
        <LinearLayout
            android:id="@+id/footerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_alignParentLeft="true"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblDiscount"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/lblTPS"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblServiceFee"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/lblTVQ"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblSubTotle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- 总金额显示区域 -->
        <TextView
            android:id="@+id/valTotlePrice"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/operationLayout"
            android:layout_toRightOf="@+id/footerLayout"
            android:layout_weight="1"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:padding="0dp"
            android:gravity="right|center_vertical" />
        <!-- 操作按钮容器 -->
        <LinearLayout
            android:id="@+id/operationLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <Button
                android:id="@+id/lessButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/circle_red"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:visibility="invisible"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="3dp"/>

            <Button
                android:id="@+id/moreButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/circle_green"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:visibility="invisible"
                android:layout_marginEnd="0dp"
                android:layout_marginStart="3dp"/>
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
