<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <!-- Category Buttons and Page Controls Container -->
    <RelativeLayout
        android:id="@+id/categoryContainerWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <!-- Left Arrow Button for Category -->
        <Button
            android:id="@+id/categoryPageUp"
            android:layout_width="14dp"
            android:layout_height="24dp"
            android:background="@drawable/triangle_left"
            android:visibility="invisible"
            android:layout_alignParentStart="true" />

        <!-- Category Buttons Container -->
        <GridLayout
            android:id="@+id/categoryContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/categoryPageUp"
            android:layout_toStartOf="@id/categoryPageDown"
            android:columnCount="3"
            android:orientation="horizontal" />

        <!-- Right Arrow Button for Category -->
        <Button
            android:id="@+id/categoryPageDown"
            android:layout_width="14dp"
            android:layout_height="24dp"
            android:background="@drawable/triangle_right"
            android:visibility="invisible"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <!-- Menu Buttons and Page Controls Container -->
    <RelativeLayout
        android:id="@+id/menuContainerWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/categoryContainerWrapper"
        android:layout_marginTop="4dp">

        <!-- Left Arrow Button for Menu -->
        <Button
            android:id="@+id/menuPageUp"
            android:layout_width="14dp"
            android:layout_height="24dp"
            android:background="@drawable/triangle_left"
            android:visibility="invisible"
            android:layout_alignParentStart="true" />

        <!-- Menu Buttons Container -->
        <GridLayout
            android:id="@+id/dishContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/menuPageUp"
            android:layout_toStartOf="@id/menuPageDown"
            android:columnCount="3"
            android:orientation="horizontal" />

        <!-- Right Arrow Button for Menu -->
        <Button
            android:id="@+id/menuPageDown"
            android:layout_width="14dp"
            android:layout_height="24dp"
            android:background="@drawable/triangle_right"
            android:visibility="invisible"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

</RelativeLayout>
