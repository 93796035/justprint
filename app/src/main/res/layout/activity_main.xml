<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/BarFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    tools:context=".app.BarFrame">

    <!-- 顶部控件，如当前表格标签和选择器 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="invisible"
        android:layout_marginTop="0dp"
        android:padding="0dp">

        <TextView
            android:id="@+id/lblCurTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Current Table:"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_vertical"/>

        <Spinner
            android:id="@+id/cmbCurTable"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:background="#000000"
            android:popupBackground="#000000"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:id="@+id/lblCurBillIdx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Customer:"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:id="@+id/valCurBillIdx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:id="@+id/lblOpenTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OpenTime:"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:id="@+id/valOpenTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#757575"
        android:visibility="invisible"
        android:layout_below="@id/topBar" />
    <!-- 按钮布局 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnFlushMevBatch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="invisible"
            android:text="Flush MEV"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnRetryPrinter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="invisible"
            android:text="Retry Printer"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 主面板容器 -->
    <FrameLayout
        android:id="@+id/panel_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_status_bar"
        android:layout_below="@id/topBar"
        android:layout_marginTop="16dp">
    </FrameLayout>

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#757575"
        android:layout_above="@id/bottom_status_bar" />
    <LinearLayout
        android:id="@+id/bottom_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="0dp">

        <!-- 使这个TextView占据剩余的全部空间 -->
        <TextView
            android:id="@+id/lblStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Status:"
            android:textColor="#FFFFFF" />

        <!-- 这些TextView根据内容调整宽度 -->
        <TextView
            android:id="@+id/lblOperator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Operator:"
            android:textColor="#888888"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@+id/valOperator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@+id/lblVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="powered by ShareTheGoodOnes.com V003.030.0616"
            android:layout_marginStart="16dp"
            android:textColor="#888888" />
    </LinearLayout>

</RelativeLayout>
