<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:text="Category Name 1"/>
        <EditText
            android:id="@+id/tfdCategoryName1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            android:textSize="16sp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:text="Category Name 2"/>
        <EditText
            android:id="@+id/tfdCategoryName2"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            android:textSize="16sp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:text="Category Name 3"/>
        <EditText
            android:id="@+id/tfdCategoryName3"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            android:textSize="16sp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:text="Display Index"/>
        <EditText
            android:id="@+id/tfdDspIndexCategory"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:inputType="number"
            android:layout_marginStart="8dp"
            android:textSize="16sp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D3D3D3"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnOk"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="OK" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Cancel" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Delete" />
    </LinearLayout>
</LinearLayout>
