<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:padding="2dp"
    android:orientation="vertical"
    tools:context="com.just.print.ui.fragment.OrderIdentifierFragment">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:id="@+id/odInfoCollect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/odInputNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Please Input Your Number:"
            android:textAlignment="center"
            android:textColor="#0091c1"
            android:textSize="36sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/odInfoInputed"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:textAlignment="viewEnd"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/odInfoOK"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Continue"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>
    <!--
    <LinearLayout
        android:id="@+id/odIdFrLoutMark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linettl">

        <TextView
            android:id="@+id/odIdFrLoutMarkTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:hint="Mark" />
    </LinearLayout>
-->
    <!--warning dialog when user do print report.....-->
    <LinearLayout
        android:id="@+id/alertResetDlg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/alertDeleteReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Do you want to reset report?" />
            </LinearLayout>
            <!-- buttons on warning dialog -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonCancel"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:text="    NO    " />

                <Button
                    android:id="@+id/btnConfirmResetReportOK"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:text="    YES    " />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!--main dialog -->
    <LinearLayout
        android:id="@+id/mainDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- top buttons -->
        <LinearLayout
            android:id="@+id/topButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ToggleButton
                android:id="@+id/odIdTableBtn1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/tag_bg"
                android:layout_marginBottom="2dp"
                android:button="@null"
                android:paddingBottom="5dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textOff=""
                android:textOn=""
                android:layout_weight="1" />
            <ImageButton
                android:id="@+id/odIdConfigBtn1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/setting"/>
            <ImageButton
                android:id="@+id/odIdCancelBtn1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/erase"/>
            <ImageButton
                android:id="@+id/odIdSndBtn1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ok" />

        </LinearLayout>
        <!--android:background="#FFF0F5"-->
        <!--android:background="#8A2BE2"-->

        <ViewSwitcher
            android:id="@+id/menuTableSwitcher"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inAnimation="@android:anim/slide_in_left"
            android:outAnimation="@android:anim/slide_out_right"
            android:layout_weight="1">
            <!--categories, selected dishes and menu selection area-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/categoryArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- two style of categories: grid style and flow style -->
                    <GridView
                        android:id="@+id/odIdCategoryGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <!-- to make the area fill the whole area, added a linerLayout-->
                    <LinearLayout
                        android:id="@+id/categoryFlowListPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.stupid.method.widget.flowlayout.FlowListView
                            android:id="@+id/categoryFlowList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
                <ViewSwitcher
                    android:id="@+id/menuMarkSwitcher"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inAnimation="@android:anim/slide_in_left"
                    android:outAnimation="@android:anim/slide_out_right">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <!--area of selected dishes and menu/tables-->
                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <!--mark short cuts-->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#DCDCDC"
                                android:orientation="vertical">
                                <!--
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <ToggleButton
                                        android:id="@+id/odIdDefaultTbtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/tag_bg"
                                        android:layout_marginTop="10px"
                                        android:layout_marginLeft="10px"
                                        android:layout_marginRight="20px"
                                        android:button="@null"
                                        android:minHeight="10dp"
                                        android:minWidth="25dp"
                                        android:paddingBottom="5dp"
                                        android:paddingLeft="10dp"
                                        android:paddingRight="10dp"
                                        android:paddingTop="5dp"
                                        android:textOff=""
                                        android:textOn=""
                                        android:layout_weight="1"/>
                                </LinearLayout>
                                -->
                                <GridView
                                    android:id="@+id/odIdShortCutMarksGrid"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:numColumns="2">
                                </GridView>
                            </LinearLayout>
                            <!--selected dishes-->
                            <ListView
                                android:id="@+id/odIdFrLoutMenuList"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:divider="#000000"
                                android:dividerHeight="1px"
                                android:stackFromBottom="true"
                                android:transcriptMode="alwaysScroll">

                            </ListView>
                        </LinearLayout>
                        <!--menu area-->
                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <!--input content-->
                            <LinearLayout
                                android:id="@+id/odIdInfo"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/odIdInput"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="ID" />

                                <TextView
                                    android:id="@+id/odIdfrName"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />
                            </LinearLayout>

                            <!--key board-->
                            <GridView
                                android:id="@+id/odMenuGv"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="4"
                                android:numColumns="2"
                                android:textSize="24sp"
                                android:textStyle="bold"></GridView>

                            <!-- send button @NOTE:seems must give it a height, and have to give it a weight-->
                            <Button
                                android:id="@+id/odIdSndBtn0"
                                android:layout_width="match_parent"
                                android:layout_height="123dp"
                                android:layout_weight="1"
                                android:background="@android:color/background_dark"
                                android:text="SEND"
                                android:textColor="@android:color/holo_red_dark"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                            <!--ToolBar-->
                            <LinearLayout
                                android:id="@+id/odIdTools"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:paddingLeft="5dp"
                                android:paddingTop="5dp"
                                android:paddingRight="2dp"
                                android:paddingBottom="0dp"
                                android:radius="2dp">

                                <ToggleButton
                                    android:id="@+id/odIdTable2"
                                    android:layout_width="match_parent"
                                    android:layout_height="55dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/tag_bg"
                                    android:button="@null"
                                    android:paddingLeft="10dp"
                                    android:paddingRight="10dp"
                                    android:paddingBottom="5dp"
                                    android:textOff=""
                                    android:textOn="T" />

                                <ImageButton
                                    android:id="@+id/odIdCancelBtn2"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_weight="1"
                                    android:src="@drawable/erase" />

                                <ImageButton
                                    android:id="@+id/odIdConfigBtn2"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_weight="1"
                                    android:src="@drawable/setting" />

                                <ImageButton
                                    android:id="@+id/odIdSndBtn2"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_weight="1"
                                    android:src="@drawable/send" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!--marks-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <GridView
                            android:id="@+id/allMarkList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:divider="#000000"
                            android:dividerHeight="2px"
                            android:stackFromBottom="true"
                            android:transcriptMode="alwaysScroll"

                            android:layout_weight="4"
                            android:numColumns="1"
                            android:textSize="24sp"
                            android:textStyle="bold">
                        </GridView>

                        <!--LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button android:id="@+id/odMarkSelectionCancel"
                                android:layout_width="100dp"
                                android:layout_height="40dp"
                                android:text="Cancel"/>

                            <Button android:id="@+id/odMarkSelectionOK"
                                android:layout_width="100dp"
                                android:layout_height="40dp"
                                android:text="OK"/>

                        </LinearLayout-->
                    </LinearLayout>
                </ViewSwitcher>
            </LinearLayout>

            <!--tables-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <!-- table list -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="6"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tableSelectionView"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:text="Table" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@android:color/darker_gray"/>
                    <GridView
                        android:id="@+id/odTableGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <!-- when user click a table which already has unclosed bill on it, show this area up-->
                <LinearLayout
                    android:id="@+id/billOnTable"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- billId tableId and OpenTime-->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@android:color/darker_gray"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/table2"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:textSize="14sp"
                            android:text="    Table:#" />
                        <TextView
                            android:id="@+id/billIdx2"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:textSize="14sp"
                            android:text="    BillId:#" />
                        <TextView
                            android:id="@+id/openTime"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:textSize="14sp"
                            android:text="    OpenTime:" />
                    </LinearLayout>
                    <!-- sub and total -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@android:color/darker_gray"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/subtotal2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:text="  Sub: $" />
                        <TextView
                            android:id="@+id/total2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:text="    Total: $" />
                    </LinearLayout>
                    <!--- ordered contents -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@android:color/darker_gray"/>
                    <ListView
                        android:id="@+id/orderList2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"  />
                    <!-- control buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/cancelShowingBill"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:text="Cancel" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/OKCloseTable"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:text="Close Table" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ViewSwitcher>
    </LinearLayout>

    <!--input dialog-->
    <LinearLayout
        android:id="@+id/inputTableName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/notice2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Please input table name:" />

        <EditText
            android:id="@+id/tableName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/tableNameOK"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue" />
    </LinearLayout>

    <!-- when user longclick send button show this area up for waiter to select a bill to add into.-->
    <LinearLayout
        android:id="@+id/recentOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancelSelectBillId"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="Cancel" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/OKSelectBillId"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="    OK    " />
        </LinearLayout>
        <!-- bill list -->
        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:background="@android:color/darker_gray"/>
        <com.stupid.method.widget.flowlayout.FlowListView
            android:id="@+id/billList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <!-- detail of a bill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!-- billId tableId and OpenTime-->
            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="@android:color/darker_gray"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/billIdx"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:textSize="14sp"
                    android:text="    BillId:#" />
                <TextView
                    android:id="@+id/table"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:textSize="14sp"
                    android:text="    Table:#" />
                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:textSize="14sp"
                    android:text="    Time:" />
            </LinearLayout>
            <!-- sub and total -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"/>
            <LinearLayout
                android:id="@+id/sub_and_total"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/subtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:text="  Sub: $" />
                <TextView
                    android:id="@+id/total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:text="    Total: $" />
            </LinearLayout>
            <!--- ordered contents -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"/>
            <ListView
                android:id="@+id/orderList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"  />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
