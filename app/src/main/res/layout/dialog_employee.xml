<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical">
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Employee Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:paddingBottom="8dp" />
        <TextView
            android:id="@+id/tvIdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID:"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingEnd="8dp" />
        <TextView
            android:id="@+id/tvIdValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Nick Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical">
        <TextView
            android:id="@+id/tvNNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nick Name"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingEnd="8dp" />
        <EditText
            android:id="@+id/edtNName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:inputType="text"/>

        <TextView
            android:id="@+id/tvPwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pass Code"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="8dp" />
        <EditText
            android:id="@+id/edtPwd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="textPassword"/>

        <TextView
            android:id="@+id/tvNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingEnd="8dp" />
        <EditText
            android:id="@+id/edtName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:inputType="text"/>

        <TextView
            android:id="@+id/tvfamilyNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Family Name"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingEnd="8dp" />
        <EditText
            android:id="@+id/edtFamilyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:inputType="text"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical">
        <!-- Lang RadioBox -->
        <RadioGroup
            android:id="@+id/radioLangGroup"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:checkedButton="@+id/radioEn"> <!-- 默认选中第二个RadioButton -->

            <TextView
                android:id="@+id/tvLangLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lang"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:paddingEnd="8dp" />

            <RadioButton
                android:id="@+id/radioFr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="français"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/radioEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/radioZh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中文"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <!-- Role RadioBox -->
        <RadioGroup
            android:id="@+id/radioRoleGroup"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:checkedButton="@+id/radioEmployee">

            <TextView
                android:id="@+id/tvRoleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:paddingEnd="8dp" />
            <RadioButton
                android:id="@+id/radioCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer"
                android:textColor="@android:color/white" />
            <RadioButton
                android:id="@+id/radioEmployee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Employee"
                android:textColor="@android:color/white" />
            <RadioButton
                android:id="@+id/radioManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manager"
                android:textColor="@android:color/white" />
            <RadioButton
                android:id="@+id/radioAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textColor="@android:color/white" />
        </RadioGroup>
    </LinearLayout>

    <!-- noTVQ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical">

        <TextView
            android:id="@+id/tvNoTVQLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TVQ"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/edtNoTVQ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:inputType="text"/>

        <TextView
            android:id="@+id/tvNoTPSLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TPS"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/edtNoTPS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:inputType="text"/>
    </LinearLayout>
    <!-- Join Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical">

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/edtAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvJoinTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join Time"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/edtJoinTime"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</LinearLayout>
