<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gridLayoutTables"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="4dp">
    <!-- Top Section -->
    <RelativeLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/buttonBar"
        android:paddingLeft="4dp">

        <!-- Left Part of Top Section -->
        <RelativeLayout
            android:id="@+id/leftTopSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true">

            <LinearLayout
                android:id="@+id/gstAndQst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblGST"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GST" />

                <EditText
                    android:id="@+id/tfdGST"
                    android:layout_width="0dp"
                    android:layout_height="31dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp" />

                <TextView
                    android:id="@+id/lblQST"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="QST" />

                <EditText
                    android:id="@+id/tfdQST"
                    android:layout_width="0dp"
                    android:layout_height="31dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/billPageLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/gstAndQst"
                android:orientation="horizontal">
            <!-- Bill Page Row Label and Text Field -->
                <TextView
                    android:id="@+id/lblBillPageRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bill Page Row" />

                <EditText
                    android:id="@+id/tfdBillPageRow"
                    android:layout_width="match_parent"
                    android:layout_height="31dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp" />

                <!-- Bill Page Col Label and Text Field -->
                <TextView
                    android:id="@+id/lblBillPageCol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bill Page Col"
                    android:layout_marginStart="16dp" />

                <EditText
                    android:id="@+id/tfdBillPageCol"
                    android:layout_width="match_parent"
                    android:layout_height="31dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:layout_toEndOf="@id/lblBillPageCol"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp"  />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/startAndWaitTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/billPageLayout"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/lblStartTimeOfDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Time of Day" />

                <EditText
                    android:id="@+id/tfdStartTimeOfDay"
                    android:layout_width="match_parent"
                    android:layout_height="31dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:layout_alignBaseline="@id/lblStartTimeOfDay"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp" />

                <!-- Printer Min Reach Time Label and Text Field -->
                <TextView
                    android:id="@+id/lblPrinterMinReachTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Printer Min Reach Time"
                    android:layout_marginStart="16dp"/>
                <EditText
                    android:id="@+id/tfdPrinterMinReachTime"
                    android:layout_width="match_parent"
                    android:layout_height="31dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:layout_alignBaseline="@id/lblPrinterMinReachTime"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp" />
            </LinearLayout>
            <View
                android:id="@+id/horizontalSeparator1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000"
                android:layout_below="@id/startAndWaitTime"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>
            <!-- Server Host Label and Text Field -->
            <LinearLayout
                android:id="@+id/serverHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/horizontalSeparator1"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/lblServerHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Server Host" />
                <EditText
                    android:id="@+id/tfdServerHost"
                    android:layout_width="match_parent"
                    android:layout_height="31dp"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp"  />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/DBHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/serverHost"
                android:orientation="horizontal">
                <!-- DB Host Label and Text Field -->
                <TextView
                    android:id="@+id/lblDBHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DB Host" />
                <EditText
                    android:id="@+id/tfdDBHost"
                    android:layout_width="match_parent"
                    android:layout_height="31dp"
                    android:layout_alignBaseline="@id/lblDBHost"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp"  />
            </LinearLayout>
            <!-- MEV Wait Time Label and Text Field -->
            <LinearLayout
                android:id="@+id/WaitTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/DBHost"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/lblMevWaitTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEV Wait Time" />
                <EditText
                    android:id="@+id/tfdMevWaitTime"
                    android:layout_width="match_parent"
                    android:layout_height="31dp"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp" />
            </LinearLayout>
            <!-- Logout Time Label and Text Field -->
            <LinearLayout
                android:id="@+id/LogoutTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/WaitTime"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/lblLogoutTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout Time" />
                <EditText
                    android:id="@+id/tfdLogoutTime"
                    android:layout_width="match_parent"
                    android:layout_height="31dp"
                    android:singleLine="true"
                    android:layout_alignBaseline="@id/lblLogoutTime"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp"  />
            </LinearLayout>

            <View
                android:id="@+id/horizontalSeparator2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000"
                android:layout_below="@id/LogoutTime"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>

            <CheckBox
                android:id="@+id/cbxIsTrainingMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/horizontalSeparator2"
                android:text="Is Training Mode" />
            <CheckBox
                android:id="@+id/cbxIsSingleUserMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsTrainingMode"
                android:text="Is Single User Mode" />
            <CheckBox
                android:id="@+id/cbxIsBuffetMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsSingleUserMode"
                android:text="Is Buffet Mode" />
            <CheckBox
                android:id="@+id/cbxIsFastFoodMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsBuffetMode"
                android:text="Is Fast Food Mode" />
            <CheckBox
                android:id="@+id/cbxIsDiscoutAffectTax"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsFastFoodMode"
                android:text="Is Discount Affect Tax" />
            <CheckBox
                android:id="@+id/cbxIsServiceFeeAffectTax"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsDiscoutAffectTax"
                android:text="Is Service Fee Affect Tax" />
            <CheckBox
                android:id="@+id/cbxIsHideRecordFromOtherWaiter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsServiceFeeAffectTax"
                android:text="Is Hide Record From Other Waiter" />
            <CheckBox
                android:id="@+id/cbxIsWaiterAllowedToDiscount"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsHideRecordFromOtherWaiter"
                android:text="Is Waiter Allowed To Discount" />
            <CheckBox
                android:id="@+id/cbxIsWaiterAllowedToChangePrice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsWaiterAllowedToDiscount"
                android:text="Is Waiter Allowed To Change Price" />
            <CheckBox
                android:id="@+id/cbxShowCustomerFrame"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@id/cbxIsWaiterAllowedToChangePrice"
                android:text="Show Customer Frame" />
        </RelativeLayout>

        <!-- Right Part of Top Section -->
        <RelativeLayout
            android:id="@+id/rightTopSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true">

            <!-- Command Buttons Container -->
            <LinearLayout
                android:id="@+id/commandButtonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <Button
                    android:id="@+id/bkMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backup Menu" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <Button
                    android:id="@+id/restoreMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restore Menu" />
                <Button
                    android:id="@+id/moreOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More Options" />
            </LinearLayout>

            <!-- Menu Panel Content -->
            <FrameLayout
                android:id="@+id/menuPanelContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/commandButtonsContainer">
            </FrameLayout>
        </RelativeLayout>
    </RelativeLayout>

    <!-- 底部按钮条容器 -->
    <LinearLayout
        android:id="@+id/buttonBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">
    </LinearLayout>
</RelativeLayout>
